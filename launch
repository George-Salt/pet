#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")"
case "${1:-}" in
    --yandex-track|--yandex-track=*|--yandex-wave|--yandex-search|--yandex-search=*|--yandex-artist|--yandex-artist=*|--yandex-favorites)
        exec /usr/bin/python3 -m hyprpet.yandex "$@"
        ;;
esac
exec /usr/bin/python3 -m hyprpet "$@"
